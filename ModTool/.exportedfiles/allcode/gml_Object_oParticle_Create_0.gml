reset_particles_around = function()
{
    emmiterFullScreenNbr = -8;
    part_type_shape(pFloatAround, 0);
    part_type_size(pFloatAround, 1, 2, 0, 0);
    part_type_scale(pFloatAround, 1, 1);
    part_type_orientation(pFloatAround, 0, 0, 0, 0, 0);
    part_type_color3(pFloatAround, global.color.grey8, global.color.blue6, global.color.grey8);
    part_type_alpha3(pFloatAround, 0, 1, 0);
    part_type_blend(pFloatAround, 0);
    part_type_life(pFloatAround, 500, 1000);
    part_type_speed(pFloatAround, 0.01, 0.1, 0, 0);
    part_type_direction(pFloatAround, 0, 360, 0, 0);
    part_type_gravity(pFloatAround, 0, 270);
    part_emitter_region(global.particlesSys, emmiterFullScreen, 0, room_width, 0, room_height, 0, 0);
    part_emitter_stream(global.particlesSys, emmiterFullScreen, pFloatAround, emmiterFullScreenNbr);
};

